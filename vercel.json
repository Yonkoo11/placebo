{
  "functions": {
    "api/trial.py": {
      "maxDuration": 30,
      "includeFiles": "{placebo/**,data/candles_*,data/funding_*,data/snapshot.json,data/reference_positions.json}"
    }
  },
  "rewrites": [
    {
      "source": "/t/:token",
